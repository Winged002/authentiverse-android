<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Authentiverse" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ds_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#E2E8FF</item>
        <item name="colorOnPrimaryContainer">#26245F</item>
        <item name="colorSecondary">@color/ds_green</item>
        <item name="colorSurface">@color/ds_surface</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorOutline">@color/ds_outline</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Authentiverse.Dialog</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/ds_surface</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="ThemeOverlay.Authentiverse.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Authentiverse.Large</item>
    </style>

    <style name="ShapeAppearance.Authentiverse.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>
</resources>
